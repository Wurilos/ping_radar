# ============================================
# PingAlert Pro — Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ---- Application ----
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# ---- Database ----
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/pingalert?schema=public"

# ---- Authentication ----
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ---- Redis (optional for dev, required for production) ----
REDIS_URL=redis://localhost:6379
USE_REDIS=false

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ---- WhatsApp (choose one provider) ----
WHATSAPP_PROVIDER=none
# Options: none | cloud_api | twilio | evolution | custom

# WhatsApp Cloud API (Meta)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Evolution API
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Custom WhatsApp API
CUSTOM_WHATSAPP_API_URL=
CUSTOM_WHATSAPP_API_KEY=

# ---- Monitoring Defaults ----
DEFAULT_CHECK_INTERVAL=60
DEFAULT_FAIL_THRESHOLD=3
DEFAULT_ALERT_COOLDOWN=300
DEFAULT_PING_TIMEOUT=5000
DEFAULT_HTTP_TIMEOUT=10000
DEFAULT_TCP_TIMEOUT=5000

# ---- Security ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=12

# ---- Quiet Hours ----
QUIET_HOURS_ENABLED=false
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00

# ---- Logging ----
LOG_LEVEL=info
